{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm run install:all",
  "outputDirectory": "client",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://third-eye-back.onrender.com/api/:path*"
    }
  ]
}
